APP_ENV=production
APP_PORT=8080
POSTGRES_PORT=5432

POSTGRES_DB=traffic_monitor
POSTGRES_USER=traffic_monitor
POSTGRES_PASSWORD=traffic_monitor

SESSION_SECRET=replace-with-session-secret
APP_MASTER_KEY=replace-with-base64-32-byte-key
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=replace-with-admin-password
LOG_LEVEL=info
LOG_FORMAT=json
COLLECTOR_INTERVAL=300s

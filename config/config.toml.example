[app]
name = "traffic-monitor"
env = "development"

[collector]
enabled = true
interval = "5m"
max_workers = 5
retry_times = 1

[http]
addr = ":8086"
read_timeout = "10s"
write_timeout = "10s"
stop_timeout = "15s"

[database]
dsn = "host=127.0.0.1 user=postgres password=postgres dbname=traffic_monitor port=5432 sslmode=disable"
max_idle_conns = 5
max_open_conns = 20
conn_max_lifetime = "30m"
ping_timeout = "5s"

[log]
level = "info"
format = "json"

[session]
# Prefer environment variable SESSION_SECRET in runtime.
secret = "replace-with-session-secret"
cookie_name = "traffic_monitor_session"
max_age = "24h"
secure = false

[ssh]
dial_timeout = "5s"
command_timeout = "10s"

[security]
# APP_MASTER_KEY must be a base64-encoded 32-byte key.
app_master_key = "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="

[bootstrap]
# 运行时优先使用环境变量 INIT_ADMIN_USERNAME 和 INIT_ADMIN_PASSWORD；两者都留空时会自动创建 admin 并打印随机密码。
init_admin_username = "admin"
init_admin_password = "replace-with-admin-password"

[restore]
# Set mode to "admin-password" and token to a strong random value only when password recovery is needed.
mode = ""
token = ""
